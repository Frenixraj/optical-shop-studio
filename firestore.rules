
rules_version = '2';

// Helper function to check if the user is the specific allowed user
function isSpecificUser(userId) {
  // IMPORTANT: Replace 'YOUR_VISIONCLEAR_USER_UID' with the actual Firebase UID
  // of the 'visionclear@example.com' user after they have logged in once.
  // You can find the UID in the Firebase Authentication console.
  // Example UID: 'AbCdEfGhIjKlMnOpQrStUvWxYz12345'
  return request.auth != null && request.auth.uid == 'YOUR_VISIONCLEAR_USER_UID';
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow ONLY the specific 'visionclear' user to read/write customers
    match /customers/{customerId} {
      allow read, write: if isSpecificUser(request.auth.uid);
    }

    // Allow ONLY the specific 'visionclear' user to read/write prescriptions
    match /prescriptions/{prescriptionId} {
      allow read, write: if isSpecificUser(request.auth.uid);
    }

    // Allow ONLY the specific 'visionclear' user to read/write invoices and their products
    match /invoices/{invoiceId} {
      allow read, write: if isSpecificUser(request.auth.uid);

      // Rules for the products subcollection within an invoice
      match /products/{productId} {
        allow read, write: if isSpecificUser(request.auth.uid);
      }
    }

     // Allow ONLY the specific 'visionclear' user to read/write the bill counter
     match /counters/billCounter {
       allow read, write: if isSpecificUser(request.auth.uid);
     }

    // Optionally deny access to any other paths by default
    // match /{document=**} {
    //   allow read, write: if false; // Default deny for anything not explicitly allowed above
    // }
  }
}
