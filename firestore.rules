
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: This allows ANY client to read and write to your database.
    // This is NOT secure for a production application accessible by untrusted users.
    // Use this ONLY if the application itself is protected by other means (e.g., network restrictions)
    // or for initial development/testing where security is not the primary concern.
    // For production, you MUST implement proper Firebase Authentication and security rules
    // based on user identity and roles.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
