rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to all documents if the user is authenticated
    // WARNING: This is a broad rule suitable for initial development.
    // For production, you MUST define more granular rules to protect user data.
    // Examples:
    // match /customers/{customerId} {
    //   allow read, write: if request.auth != null && request.auth.uid == customerId; // User can access their own data
    // }
    // match /invoices/{invoiceId} {
    //   allow read, write: if request.auth != null; // Authenticated users can manage invoices (adjust as needed)
    // }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Explicitly allow access to the bill counter for authenticated users
    match /counters/billCounter {
       allow read, write: if request.auth != null;
    }
  }
}
