rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all reads and writes during development.
    // WARNING: This is insecure and MUST be changed before deploying to production.
    // Consider implementing Firebase Authentication and stricter rules.
    match /{document=**} {
      allow read, write: if true; // Allow any access (INSECURE FOR PRODUCTION)
    }

    // Example of more secure rules (requires Firebase Auth):
    /*
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /customers/{customerId} {
        allow read: if request.auth != null; // Allow logged-in users to read
        allow create, update, delete: if request.auth != null; // Allow logged-in users to manage
    }
    match /prescriptions/{prescriptionId} {
        // Allow read/write if user owns the related customer record (more complex rule)
        // Or simply allow logged-in users
        allow read, write: if request.auth != null;
    }
     match /invoices/{invoiceId} {
        allow read, write: if request.auth != null;
     }
     match /invoices/{invoiceId}/products/{productId} {
         allow read, write: if request.auth != null; // Access based on parent invoice
     }
      match /counters/billCounter {
        allow read, write: if request.auth != null; // Allow logged-in users to manage counter
      }
    */
  }
}